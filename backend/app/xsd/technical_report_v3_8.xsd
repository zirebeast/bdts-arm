<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  XSD-схема XML-представления технического отчёта
  Модель данных: v3.8 (DataModel_v3_8_updates.txt, Dictionaty_v3_8.txt,
                       dictionaries_seed_v3_8.json)
  Версия XSD: 1.0 (без xs:assert / xs:alternative — совместима с libxml2, Xerces, .NET)
  ============================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tr="urn:gazprom-diagnostics:technical-report:3.8"
           targetNamespace="urn:gazprom-diagnostics:technical-report:3.8"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="3.8">

  <!-- ====================================================================== -->
  <!-- 1. БАЗОВЫЕ ПРОСТЫЕ ТИПЫ                                                -->
  <!-- ====================================================================== -->

  <xs:simpleType name="UuidType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CodeType">
    <xs:annotation><xs:documentation>Код записи справочника (PK). Без пробельных символов.
      Единый тип для всех key/keyref (требование совпадения типов значений).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
      <xs:maxLength value="128"/>
      <xs:pattern value="\S+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SourceCodeType">
    <xs:annotation><xs:documentation>Код записи в системе-источнике КАК СТРОКА (ведущие нули сохраняются).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
      <xs:maxLength value="64"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonBlankTextType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[\s\S]*\S[\s\S]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ShortTextType">
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
      <xs:maxLength value="500"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PositiveDecimalType">
    <xs:restriction base="xs:decimal"><xs:minExclusive value="0"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonNegativeDecimalType">
    <xs:restriction base="xs:decimal"><xs:minInclusive value="0"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HbValueType">
    <xs:annotation><xs:documentation>Твёрдость по Бринеллю, HB.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="999"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Sha256Type">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9a-fA-F]{64}"/></xs:restriction>
  </xs:simpleType>

  <!-- ====================================================================== -->
  <!-- 2. СКВОЗНЫЕ ПОЛЯ ПРОИСХОЖДЕНИЯ (C-01)                                  -->
  <!-- ====================================================================== -->

  <xs:simpleType name="SourceSystemType">
    <xs:annotation><xs:documentation>Одна система или сочетание через «+» для записей,
      совпавших в двух источниках (например legacy_mvp+asupp).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(asupp|ods_tpa|ods_srd_tpo|report_batch|report_to|form_sample|legacy_mvp|manual)(\+(asupp|ods_tpa|ods_srd_tpo|report_batch|report_to|form_sample|legacy_mvp|manual))*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="QualityFlagType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="no_norm_data"/>
      <xs:enumeration value="lookalike_chars"/>
      <xs:enumeration value="suspected_typo"/>
      <xs:enumeration value="hb_weld_ge_300"/>
      <xs:enumeration value="placeholder_excluded"/>
      <xs:enumeration value="duplicate_merged"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="QualityFlagsType">
    <xs:sequence>
      <xs:element name="quality_flag" type="tr:QualityFlagType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="VerificationStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="confirmed"/>
      <xs:enumeration value="candidate"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ExportedVerificationStatusType">
    <xs:annotation><xs:documentation>V-DIC-052: в XML выгружаются только confirmed.</xs:documentation></xs:annotation>
    <xs:restriction base="tr:VerificationStatusType">
      <xs:enumeration value="confirmed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:group name="ProvenanceGroup">
    <xs:annotation><xs:documentation>Поля происхождения записи справочника (п. 1.1 модели).
      source_system по умолчанию legacy_mvp (элемент обязателен в выгрузке).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="source_code" type="tr:SourceCodeType" minOccurs="0"/>
      <xs:element name="source_system" type="tr:SourceSystemType"/>
      <xs:element name="quality_flags" type="tr:QualityFlagsType" minOccurs="0"/>
      <xs:element name="verification_status" type="tr:ExportedVerificationStatusType"/>
    </xs:sequence>
  </xs:group>


  <xs:group name="ProvenanceStructuralGroup">
    <xs:annotation><xs:documentation>ОТСТУПЛЕНИЕ ОТ V-DIC-052 (осознанное): узлы-группы Equipment_Types — чисто структурные.
      Все подтверждённые типы MVP подчинены группам со статусом candidate (asupp_000000003 «Трубопроводная арматура»,
      asupp_000000001 «Технические устройства»); без их выгрузки parent_code «повисает» и иерархия
      (V-DIC-042, наследование applies_to_equipment_types[] по предкам, п. 2.3а) теряется.
      Поэтому группы-предки подтверждённых типов выгружаются с любым статусом. Листья — только confirmed.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="source_code" type="tr:SourceCodeType" minOccurs="0"/>
      <xs:element name="source_system" type="tr:SourceSystemType"/>
      <xs:element name="quality_flags" type="tr:QualityFlagsType" minOccurs="0"/>
      <xs:element name="verification_status" type="tr:VerificationStatusType"/>
    </xs:sequence>
  </xs:group>

  <!-- ====================================================================== -->
  <!-- 3. ПЕРЕЧИСЛЕНИЯ (закрытые справочники и enum-поля модели)              -->
  <!-- ====================================================================== -->

  <!-- 3.1 Закрытые справочники ведомости (enum по п. 1.3) -->
  <xs:simpleType name="NoncomplianceCategoryType">
    <xs:annotation><xs:documentation>Noncompliance_Categories.
      project_docs, operation_docs → шкала conformity; остальные → fit (default_scale).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="project_docs"><xs:annotation><xs:documentation>Несоответствия проектной документации</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="operation_docs"><xs:annotation><xs:documentation>Несоответствия эксплуатационной документации</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="structure_defects"><xs:annotation><xs:documentation>Дефекты конструкций</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="ecp_defects"><xs:annotation><xs:documentation>Дефекты средств ЭХЗ</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="electrical_defects"><xs:annotation><xs:documentation>Дефекты электрооборудования</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="functional_defects"><xs:annotation><xs:documentation>Функциональные дефекты</xs:documentation></xs:annotation></xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AdmissibilityAssessmentType">
    <xs:annotation><xs:documentation>Admissibility_Assessments. Шкала fit: fit/not_fit; шкала conformity: corresponds/not_corresponds.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="fit"><xs:annotation><xs:documentation>Годен</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="not_fit"><xs:annotation><xs:documentation>Не годен</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="corresponds"><xs:annotation><xs:documentation>Соответствует</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="not_corresponds"><xs:annotation><xs:documentation>Не соответствует</xs:documentation></xs:annotation></xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BuildingTechnicalStateType">
    <xs:annotation><xs:documentation>Building_Technical_States, ГОСТ 31937-2011.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="normative"><xs:annotation><xs:documentation>1. Нормативное техническое состояние</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="serviceable"><xs:annotation><xs:documentation>2. Работоспособное техническое состояние</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="limited_serviceable"><xs:annotation><xs:documentation>3. Ограниченно-работоспособное техническое состояние</xs:documentation></xs:annotation></xs:enumeration>
      <xs:enumeration value="emergency"><xs:annotation><xs:documentation>4. Аварийное состояние</xs:documentation></xs:annotation></xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <!-- 3.2 Enum-поля справочников -->
  <xs:simpleType name="MaterialKindType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="steel"/><xs:enumeration value="non_ferrous"/><xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConflictStateType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/><xs:enumeration value="open"/><xs:enumeration value="resolved"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PartScopeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="body_cast"/><xs:enumeration value="body_forged"/>
      <xs:enumeration value="pipe_element"/><xs:enumeration value="weld_haz"/>
      <xs:enumeration value="bolt"/><xs:enumeration value="nut"/><xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AggregationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="single"/><xs:enumeration value="mean"/>
      <xs:enumeration value="min"/><xs:enumeration value="max"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EquipmentCategoryType">
    <xs:annotation><xs:documentation>Категория типа ЕО. electric_equipment и building остаются в enum
      (candidate-категории, подтверждены только образцом ведомости и ВДП).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="valve_armature"/>
      <xs:enumeration value="pipeline_element"/>
      <xs:enumeration value="vessel"/>
      <xs:enumeration value="wellhead_assembly"/>
      <xs:enumeration value="station_complex"/>
      <xs:enumeration value="electric_equipment"/>
      <xs:enumeration value="building"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="WorkingMediumCategoryType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="gas"/><xs:enumeration value="liquid"/>
      <xs:enumeration value="test_medium"/><xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ControlSchemeUnitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="points"/><xs:enumeration value="zones"/><xs:enumeration value="surface"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ClimateCategoryType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/><xs:maxInclusive value="4"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 3.3 Enum-поля сущностей отчёта -->
  <xs:simpleType name="ThicknessBasisType">
    <xs:annotation><xs:documentation>Эталон толщины для V-EQ-018, V-UZT-007, V-CAL-010. Default: nominal.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="nominal"/><xs:enumeration value="calc_min"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SCalcMinSourceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="calc_sto"/><xs:enumeration value="passport_tu"/><xs:enumeration value="manual_justified"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EquipmentOriginType">
    <xs:annotation><xs:documentation>Default: unknown.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="asupp"/><xs:enumeration value="field_created"/><xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SyncStatusType">
    <xs:annotation><xs:documentation>Default: not_applicable.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="synced"/><xs:enumeration value="pending"/>
      <xs:enumeration value="conflict"/><xs:enumeration value="not_applicable"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProtocolNumberingModeType">
    <xs:annotation><xs:documentation>auto_mask — маска MVP {report_number}-{order:02d} (default);
      manual — номер вводится вручную, V-P-010 отключается.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="auto_mask"/><xs:enumeration value="manual"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VolumeKindType">
    <xs:annotation><xs:documentation>Default: number.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="number"/><xs:enumeration value="percent"/>
      <xs:enumeration value="by_estimate"/><xs:enumeration value="by_program"/><xs:enumeration value="text"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PhotoKindType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="eo"/><xs:enumeration value="building_structure"/>
      <xs:enumeration value="scheme"/><xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MethodRunStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="performed"/><xs:enumeration value="not_performed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MethodNotPerformedReasonType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="object_not_stopped"/><xs:enumeration value="not_applicable"/>
      <xs:enumeration value="not_in_scope"/><xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StatementStatusType">
    <xs:annotation><xs:documentation>Default: draft. При issued номер, дата и исполнитель обязательны (V-DS-004).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="draft"/><xs:enumeration value="issued"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdentifierKindType">
    <xs:annotation><xs:documentation>Вид идентификатора объекта в ведомости дефектов. Default: none.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="factory_no"/><xs:enumeration value="tech_no"/>
      <xs:enumeration value="reg_no"/><xs:enumeration value="inv_no"/>
      <xs:enumeration value="km"/><xs:enumeration value="range_km"/><xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ClockPositionType">
    <xs:annotation><xs:documentation>Часовая ориентация (расширение мемо): час 1–12 или время ЧЧ:ММ (V-DS-011).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(1[0-2]|[1-9])"/>
      <xs:pattern value="([01]?[0-9]|2[0-3]):[0-5][0-9]"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ====================================================================== -->
  <!-- 4. ЗАПИСИ СПРАВОЧНИКОВ (содержимое снимков)                            -->
  <!-- ====================================================================== -->

  <!-- 4.1 Steel_Grades + Steel_Grade_Source_Values (C-02) -->
  <xs:complexType name="SteelGradeSourceValueType">
    <xs:annotation><xs:documentation>Steel_Grade_Source_Values: значения одного источника для марки. Служебная, в валидаторах не участвует.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="source_system" type="tr:SourceSystemType"/>
      <xs:element name="source_code" type="tr:SourceCodeType" minOccurs="0"/>
      <xs:element name="hb_min" type="tr:HbValueType" minOccurs="0"/>
      <xs:element name="hb_max" type="tr:HbValueType" minOccurs="0"/>
      <xs:element name="hb_weld" type="tr:HbValueType" minOccurs="0"/>
      <xs:element name="sigma" type="xs:decimal" minOccurs="0"/>
      <xs:element name="steel_class" type="tr:ShortTextType" minOccurs="0"/>
      <xs:element name="has_norm_data" type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SteelGradeType">
    <xs:sequence>
      <xs:element name="code" type="tr:CodeType"/>
      <xs:element name="name" type="tr:ShortTextType"/>
      <xs:element name="standard" type="tr:ShortTextType" minOccurs="0">
        <xs:annotation><xs:documentation>standard_ref: обязателен для legacy_mvp/confirmed; у импортированных допускается NULL.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="material_kind" type="tr:MaterialKindType" minOccurs="0">
        <xs:annotation><xs:documentation>Default: steel.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="steel_class" type="tr:ShortTextType" minOccurs="0"/>
      <xs:element name="has_norm_data" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Default: true.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="hb_min" type="tr:HbValueType" minOccurs="0"/>
      <xs:element name="hb_max" type="tr:HbValueType" minOccurs="0"/>
      <xs:element name="hb_weld_max" type="tr:HbValueType" minOccurs="0"/>
      <xs:element name="hb_weld_confirmed" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Default: false. Пока false, hb_weld_max валидаторами не используется.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="tensile_strength_mpa" type="tr:PositiveDecimalType" minOccurs="0"/>
      <xs:element name="sigma_allowable_mpa" type="tr:PositiveDecimalType" minOccurs="0">
        <xs:annotation><xs:documentation>Обязателен, если material_kind=steel и has_norm_data=true (V-DIC-044).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="conflict_state" type="tr:ConflictStateType" minOccurs="0">
        <xs:annotation><xs:documentation>Default: none.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="source_values" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="source_value" type="tr:SteelGradeSourceValueType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:group ref="tr:ProvenanceGroup"/>
    </xs:sequence>
  </xs:complexType>

  <!-- 4.2 Equipment_Types (C-04): группы и листья в разных элементах -->
  <xs:group name="EquipmentTypeHeadGroup">
    <xs:sequence>
      <xs:element name="code" type="tr:CodeType"/>
      <xs:element name="name" type="tr:ShortTextType"/>
      <xs:element name="parent_code" type="tr:CodeType" minOccurs="0"/>
    </xs:sequence>
  </xs:group>

  <xs:group name="EquipmentTypeTailGroup">
    <xs:sequence>
      <xs:element name="category" type="tr:EquipmentCategoryType"/>
      <xs:element name="requires_geometry" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Default: true. false — типы без DN/PN/толщины.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="purpose" type="tr:NonBlankTextType" minOccurs="0"/>
      <xs:group ref="tr:ProvenanceGroup"/>
    </xs:sequence>
  </xs:group>

  <xs:complexType name="EquipmentTypeGroupNodeType">
    <xs:annotation><xs:documentation>Узел-группа (is_group=true). В Equipment.equipment_type выбираться не может.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:group ref="tr:EquipmentTypeHeadGroup"/>
      <xs:element name="is_group" type="xs:boolean" fixed="true"/>
      <xs:element name="category" type="tr:EquipmentCategoryType"/>
      <xs:element name="requires_geometry" type="xs:boolean" minOccurs="0"/>
      <xs:element name="purpose" type="tr:NonBlankTextType" minOccurs="0"/>
      <xs:group ref="tr:ProvenanceStructuralGroup"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EquipmentTypeLeafType">
    <xs:annotation><xs:documentation>Лист иерархии (is_group=false). Допустим как Equipment.equipment_type (V-EQ-032).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:group ref="tr:EquipmentTypeHeadGroup"/>
      <xs:element name="is_group" type="xs:boolean" fixed="false" minOccurs="0"/>
      <xs:element name="has_drive" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Обязателен для confirmed; для импортированных допускается NULL.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:group ref="tr:EquipmentTypeTailGroup"/>
    </xs:sequence>
  </xs:complexType>

  <!-- 4.3 Equipment_Marks (C-05) -->
  <xs:complexType name="EquipmentMarkType">
    <xs:sequence>
      <xs:element name="code" type="tr:CodeType"/>
      <xs:element name="equipment_type_ref" type="tr:CodeType"/>
      <xs:element name="name" type="tr:ShortTextType">
        <xs:annotation><xs:documentation>Заглушки («б/н», «н/д», «-», «индивидуальный проект») запрещены (V-DIC-043).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="design_variant_ref" type="tr:CodeType" minOccurs="0"/>
      <xs:element name="source_codes_extra" minOccurs="0">
        <xs:annotation><xs:documentation>Коды источника объединённых дублей (duplicate_merged).</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="source_code" type="tr:SourceCodeType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:group ref="tr:ProvenanceGroup"/>
    </xs:sequence>
  </xs:complexType>

  <!-- 4.4 Climate_Executions (C-06) -->
  <xs:complexType name="ClimateExecutionType">
